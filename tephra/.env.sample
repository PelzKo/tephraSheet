# Copy to tephra/.env and fill in.
SECRET_KEY=change-me-to-a-random-50-plus-character-string
DEBUG=False
# True skips SSL hardening and forces SQLite (local development).
LOCAL=True
# Public hostname; required when LOCAL=False.
EXTERNAL_HOSTNAME=
SENTRY_DSN=
# MySQL/MariaDB (used only when LOCAL=False and DB_ENGINE, DB_NAME, DB_USERNAME are set)
DB_ENGINE=django.db.backends.mysql
DB_NAME=
DB_USERNAME=
DB_PASS=
DB_HOST=localhost
DB_PORT=3306
DB_CHARSET=utf8mb4
# SMTP (used when DEBUG=False)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
